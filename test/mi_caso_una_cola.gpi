set terminal pngcairo size 1024,560 font "sans,10"
set output 'test/mi_caso_una_cola.png'
set title "Diagrama de Gantt"
set xlabel "Tiempo"
set ylabel "Proceso"
set xrange [0:24]
set yrange [0:7]
set xtics 1
set grid xtics
unset key
set ytics ("A" 6, "B" 5, "C" 4, "D" 3, "E" 2, "F" 1)
set object 1 rect from 0,5.7 to 2,6.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
