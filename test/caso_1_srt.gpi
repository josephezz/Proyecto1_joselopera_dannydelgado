set terminal pngcairo size 1024,620 font "sans,10"
set output 'test/caso_1_srt.png'
set title "Diagrama de Gantt"
set xlabel "Tiempo"
set ylabel "Proceso"
set xrange [0:35]
set yrange [0:8]
set xtics 1
set grid xtics
unset key
set ytics ("A" 7, "B" 6, "C" 5, "D" 4, "E" 3, "F" 2, "G" 1)
set object 1 rect from 8,6.92 to 9,7.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 2 rect from 9,6.92 to 10,7.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
